# Frontend (embedded at build time)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=/api/__clerk

# API runtime
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
SESSION_SECRET=
LOG_LEVEL=info

# Replit Object Storage paths work only while the API runs on Replit.
# A portable storage provider must be configured before document uploads are
# enabled on Vercel or Afrihost.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=