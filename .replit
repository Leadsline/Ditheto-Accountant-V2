modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 45000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GH_USER = "Leadsline"
SUPABASE_PRIVATE_BUCKET = "private-documents"
SUPABASE_PUBLIC_BUCKET = "public-assets"
SUPABASE_URL = "https://vnzhgajkclelpxfqbnbm.supabase.co"
